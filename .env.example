# Copie este arquivo para .env e preencha conforme o ambiente (local ou produção).
# Em branco = usa o padrão do sistema (veja src/config/env.js).
#
# Zé, pra produção os dois blocos que importam de verdade são AUTH_MODE=keycloak (com o
# bloco KEYCLOAK_* preenchido) e DB_DRIVER=oracle (com o bloco ORACLE_* preenchido). O
# resto do arquivo já tem um padrão razoável. Qualquer variável obrigatória que faltar
# pro modo escolhido, o app recusa a subir e já fala exatamente o que falta (validação
# em src/config/env.js) — não tem susto silencioso.

# --- App ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
# Gere uma string aleatória longa (ex.: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
APP_SESSION_SECRET=changeme-generate-a-long-random-string
APP_SESSION_COOKIE_NAME=ci_session
APP_SESSION_TTL_HOURS=10

# --- Autenticação ---
# dev      = login local simulado, sem depender do Keycloak (usado em desenvolvimento/homologação sem acesso ao SSO)
# keycloak = login real via Keycloak (OpenID Connect)
AUTH_MODE=dev
AUTH_JIT_PROVISION=true

# --- Keycloak (obrigatório apenas quando AUTH_MODE=keycloak) ---
KEYCLOAK_BASE_URL=https://sso.empresa.com
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
KEYCLOAK_ROLE_CLAIM_PATH=realm_access.roles
KEYCLOAK_SUPERVISOR_ROLE=supervisor
KEYCLOAK_ANALISTA_ROLE=analista

# --- Banco de dados ---
# sqlite = usa node:sqlite embutido no Node.js, ótimo para desenvolvimento/testes locais (não precisa instalar nada)
# oracle = usa o Oracle real da empresa (preencher bloco ORACLE_* abaixo)
DB_DRIVER=sqlite
SQLITE_FILE=./data/dev.sqlite3

# --- Oracle (obrigatório apenas quando DB_DRIVER=oracle) ---
ORACLE_USER=
ORACLE_PASSWORD=
# formato host:porta/service_name, ou um alias do tnsnames.ora
ORACLE_CONNECT_STRING=
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_WALLET_LOCATION=
# thin (padrão, sem precisar instalar Oracle Instant Client) ou thick (necessário só em cenários avançados)
ORACLE_CLIENT_MODE=thin

# --- E-mail ---
# console = não envia de verdade, só registra no log e na tabela NOTIFICACAO (bom para desenvolvimento)
# smtp    = envia de verdade usando as credenciais abaixo
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Central de Chamados - Comunicação Interna"
SMTP_FROM_EMAIL=chamados-ci@empresa.com

# --- Anexos ---
# filesystem  = grava os arquivos em UPLOAD_DIR (recomendado)
# oracle_blob = grava o conteúdo binário dentro do Oracle (usar só se for exigência da política de TI)
ATTACHMENT_STORAGE=filesystem
UPLOAD_DIR=./data/uploads
MAX_ANEXO_MB=100
MAX_ANEXOS_POR_CHAMADO=4
ANEXO_TIPOS_PERMITIDOS=.doc,.docx,.xls,.xlsx,.ppt,.pptx,.pdf,.png,.jpg,.jpeg,.mp4,.mov,.mp3,.wav

# --- SLA ---
SLA_TIMEZONE=America/Sao_Paulo
